[Unit]
Description=Loop pre-rendered Godot shorts (VPU decode)
After=weston.service
Wants=weston.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/user/0 WAYLAND_DISPLAY=wayland-0
ExecStartPre=/bin/sh -c 'while [ ! -S /run/user/0/wayland-0 ]; do sleep 1; done'
ExecStart=/home/yocto/godot/play-loop.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
